---
import type { Locale } from '../i18n/types';
import { getDictionary, otherLocale, STACK } from '../i18n';
import { SITE, ROUTES } from '../config/site';
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Marquee from './Marquee.astro';
import About from './About.astro';
import Pov from './Pov.astro';
import Experience from './Experience.astro';
import Education from './Education.astro';
import Architectures from './Architectures.astro';
import Skills from './Skills.astro';
import OffCode from './OffCode.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = getDictionary(locale);
const { t, d } = dict;
const alt = otherLocale(locale);
---
<Layout locale={locale} dict={dict}>
  <Header t={t} altLocale={alt} altHref={ROUTES[alt]} />
  <main id="top">
    <Hero t={t} cvHref={SITE.cv} linkedin={SITE.linkedin} />
    <Marquee items={STACK} />
    <About t={t} facts={d.facts} />
    <Pov t={t} pov={d.pov} />
    <Experience t={t} experience={d.experience} />
    <Education t={t} education={d.education} />
    <Architectures t={t} cases={d.cases} />
    <Skills t={t} skills={d.skills} />
    <OffCode t={t} off={d.off} />
    <Contact t={t} email={SITE.email} linkedin={SITE.linkedin} github={SITE.github} />
  </main>
  <Footer t={t} year={SITE.year} name={SITE.name} />
</Layout>
